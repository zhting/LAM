+def _ensure_ninja_on_subprocess_path():
+    # LAM_COMPAT_NINJA: torch 2.14 is_ninja_available() executes ['ninja', '--version']
+    # using PATH. G4 installed ninja 1.13.2 into the venv, then launched
+    # <venv>/bin/python by absolute path without activation, so PATH did not
+    # contain <venv>/bin and load() raised 'Ninja is required'. Publish the
+    # absolute executable for this process and every child. A missing binary
+    # still raises; compiler failures are not caught.
+    import shutil
+    import subprocess
+    import sysconfig
+    try:
+        import lam_runtime
+    except ImportError:
+        lam_runtime = None
+    if lam_runtime is not None:
+        return lam_runtime.require_ninja()
+    names = ['ninja.exe', 'ninja'] if os.name == 'nt' else ['ninja']
+    directories = [os.path.dirname(os.path.realpath(sys.executable))]
+    scripts = sysconfig.get_path('scripts')
+    if scripts:
+        directories.append(scripts)
+    try:
+        import ninja as ninja_dist
+    except ImportError:
+        ninja_dist = None
+    if ninja_dist is not None and getattr(ninja_dist, 'BIN_DIR', None):
+        directories.append(str(ninja_dist.BIN_DIR))
+    candidates = []
+    pinned = os.environ.get('LAM_NINJA', '').strip()
+    if pinned:
+        candidates.append(pinned)
+    for directory in directories:
+        for name in names:
+            candidates.append(os.path.join(directory, name))
+    found = shutil.which('ninja')
+    if found:
+        candidates.append(found)
+    tried = []
+    for candidate in candidates:
+        if not candidate or candidate in tried:
+            continue
+        tried.append(candidate)
+        if not (os.path.isfile(candidate) and os.access(candidate, os.X_OK)):
+            continue
+        try:
+            subprocess.check_output([candidate, '--version'], stderr=subprocess.STDOUT)
+        except (OSError, subprocess.CalledProcessError):
+            continue
+        folder = os.path.dirname(os.path.abspath(candidate))
+        current = os.environ.get('PATH', '')
+        if folder not in current.split(os.pathsep):
+            os.environ['PATH'] = folder + (os.pathsep + current if current else '')
+        os.environ['LAM_NINJA'] = os.path.abspath(candidate)
+        return os.environ['LAM_NINJA']
+    raise RuntimeError(
+        'Ninja is required to compile the backface-culling CUDA plugin, but no executable could be run. '
+        'Python: %s. Searched: %s. PATH: %s' % (sys.executable, tried, os.environ.get('PATH', '')))
+
+
